# Database Connection (MySQL or SQLite fallback)
# MySQL format: mysql+pymysql://username:password@localhost:3306/aarogyamitra_db
# Default SQLite fallback if empty: sqlite:///./aarogyamitra.db
DATABASE_URL=sqlite:///./aarogyamitra.db

# Authentication Security Settings
SECRET_KEY=aarogyamitra_super_secret_jwt_key_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed Frontend Origins for CORS (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
